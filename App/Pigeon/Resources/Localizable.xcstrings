              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clean drive to go"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clean drives to go"
                }
              }
            }
          }
