    "NSLocationWhenInUseUsageDescription": {
      "comment": "Why the app asks for location, shown in the permission prompt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pigeon uses your location to guide you along your saved routes and to notice when you leave one. Pigeon keeps your drives on this iPhone."
          }
        }
      }
